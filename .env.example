# Copy this file to .env and adjust values for your environment.
#
# NOTE — Vercel deployments need NO environment variables: the topic content
# is bundled from src/lib/site/content.json (see scripts/export_content.py),
# so no DATABASE_URL is required at build or runtime.

# SQLite database used by Prisma (local authoring store, created via
# `bunx prisma db push`). Only needed for local content tooling.
DATABASE_URL="file:/home/z/my-project/db/custom.db"
